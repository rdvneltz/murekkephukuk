# Database Connection (Required)
# MongoDB connection string for Prisma
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/murekkephukuk?retryWrites=true&w=majority

# NextAuth Configuration (Required)
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-min-32-characters
NEXTAUTH_URL=https://murekkephukuk.vercel.app

# Optional: WhatsApp Business API
# WHATSAPP_BUSINESS_API_KEY=your-api-key
# WHATSAPP_PHONE_NUMBER=your-phone-number

# Optional: Email Service (for notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-password

# Note: For Vercel deployment, set these variables in:
# Vercel Dashboard > Your Project > Settings > Environment Variables
